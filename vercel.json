{
  "crons": [
    {
      "path": "/api/cron?job=weekly-report",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron?job=check-anomalies",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron?job=purge-old-votes",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron?job=send-winback-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron?job=send-outreach-emails",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron?job=check-gmail-replies",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron?job=research-godwit-prospects",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron?job=stripe-reconciliation",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron?job=process-dsar",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/system-status",
      "destination": "/api/cron?job=system-status"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/creator",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
